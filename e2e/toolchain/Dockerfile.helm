ARG BASE_IMAGE=forgejo.develop.10.199.64.20.nip.io/easylab/toolchain-base:latest
FROM ${BASE_IMAGE}
ARG EASYLAB=http://easylab.temp.svc.cluster.local
RUN mkdir -p /opt/helm && curl -fsSL -o /tmp/helm.tgz "${EASYLAB}/pkgs/generic/helm/4.3.0/helm-v4.3.0-linux-amd64.tar.gz" \
 && tar -xzf /tmp/helm.tgz -C /tmp && mv /tmp/linux-amd64/helm /opt/helm/helm && rm -rf /tmp/helm.tgz /tmp/linux-amd64
# Bake the cm-push plugin in: it is the only client for the chartmuseum upload
# API, and installing it at runtime needs GitHub (unreliable through the
# spoofed proxy and it would leave a fresh pod without the plugin).
RUN set -eux; \
    mkdir -p /root/.local/share/helm/plugins/helm-push; \
    curl -fsSL -o /tmp/cm-push.tgz "${EASYLAB}/pkgs/generic/helm-push/0.11.1/helm-push_0.11.1_linux_amd64.tar.gz"; \
    tar -xzf /tmp/cm-push.tgz -C /root/.local/share/helm/plugins/helm-push; \
    rm /tmp/cm-push.tgz; \
    # Helm 4 uses the cli/v1 plugin manifest (the archive ships the Helm 3
    # form at plugin.yaml and the Helm 4 form under testdata/).
    mv /root/.local/share/helm/plugins/helm-push/testdata/plugin-helm4.yaml \
       /root/.local/share/helm/plugins/helm-push/plugin.yaml; \
    rm -rf /root/.local/share/helm/plugins/helm-push/testdata
ENV PATH=/opt/helm:$PATH
ENV HELM_PLUGINS=/root/.local/share/helm/plugins
